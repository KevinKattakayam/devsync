# Public build-time service origins; no credentials may use NEXT_PUBLIC.
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
NEXT_PUBLIC_YJS_URL="ws://localhost:5000"
# Clerk publishable key is intentionally public; supply a real test/deployment key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Server-only variables used by the proxy and administrative route.
BACKEND_URL="http://localhost:5000"
CLERK_SECRET_KEY=""
SUPERADMIN_SERVICE_TOKEN=""
# Optional existing telemetry configuration.
OTEL_SDK_DISABLED="true"
OTEL_EXPORTER_OTLP_ENDPOINT=""
# NODE_ENV and NEXT_RUNTIME are set by Next; do not override NEXT_RUNTIME.

# P02: opt in only after applying the decision-receipt migration.
FEATURE_DECISION_RECEIPTS=false

# P04: enable consistently on API, frontend and indexing workers after migration.
FEATURE_SNIPPET_SAFETY=false

# P06: enable after deploying the personal digest preference migration.
FEATURE_ASYNC_DIGEST=false

# Hosted builds: DEPLOYMENT_MODE=production with HTTPS/WSS URLs and real Clerk settings.
# Compose supplies DEPLOYMENT_MODE=local for keyless setup guidance. Public values are baked at build time.

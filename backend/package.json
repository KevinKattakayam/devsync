{
  "name": "devsync-backend",
  "version": "1.0.0",
  "description": "DevSync Backend API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "test": "jest --runInBand",
    "test:e2e": "playwright test -c playwright.config.ts",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@clerk/express": "^2.1.47",
    "@hocuspocus/extension-database": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/opossum": "^8.1.9",
    "bullmq": "^6.1.1",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^0.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.49.0",
    "opossum": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.0",
    "stripe": "^18.5.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.1",
    "y-protocols": "^1.0.7",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.31",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

# Required database connection. Use separate non-owner runtime and migration credentials.
DATABASE_URL=""
# Current identity provider (custom cookie/auth replacement remains unimplemented).
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
# Stable 64-hex-character AES-256 key; generate securely, never commit actual key.
ENCRYPTION_KEY=""
# Runtime mode, API port and exact permitted frontend origin.
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"
# Redis cache/presence/queues; production must use private authenticated TLS.
REDIS_URL="redis://localhost:6379"
# Optional server-only AI providers; no public provider key variables.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
# Optional legacy polling. Dedicated worker/producer alignment remains G04.
RUN_EMBEDDING_WORKER_IN_API="false"
# Optional billing: server-only Stripe credentials and meter metadata.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_TOKEN_METER_EVENT="ai_tokens"
STRIPE_PLAN_MRR_CENTS=0
# Server-to-server superadmin proxy credential; never NEXT_PUBLIC.
SUPERADMIN_SERVICE_TOKEN=""
# Optional Cloudinary integration (no exposed upload route currently).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Existing telemetry, not changed by Phase1a. Leave endpoint blank to avoid export.
OTEL_SDK_DISABLED="true"
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Structured API logging. Bodies, credentials, URLs and raw exception text are omitted.
LOG_LEVEL="info"
# Optional sanitized error reporting; disabled when empty. Keep this server-side.
SENTRY_DSN=""
# Protects /metrics. At least 32 random characters; empty disables the endpoint.
METRICS_BEARER_TOKEN=""
# Explicit non-production seed identities; not passwords/tokens. See prisma/README.md.
SEED_ALLOW_WRITE="false"
SEED_OWNER_CLERK_ID=""
SEED_EDITOR_CLERK_ID=""
SEED_VIEWER_CLERK_ID=""

# Existing future browser suite inputs; no Playwright run in Phase1a.
E2E_BASE_URL="http://localhost:3000"
E2E_WORKSPACE_ID=""
# Path to a local, ignored authenticated storage-state file; never commit its contents.
E2E_STORAGE_STATE=""
# CI is supplied by the runner when applicable.

# P02: opt in only after applying the decision-receipt migration.
FEATURE_DECISION_RECEIPTS=false

# P04: enable consistently on API, frontend and indexing workers after migration.
FEATURE_SNIPPET_SAFETY=false

# P06: enable after deploying the personal digest preference migration.
FEATURE_ASYNC_DIGEST=false

# AI admission: positive integer limits shared consistently by every API/worker.
# Global personal counts and isolated workspace counts; UTC calendar resets.
AI_QUOTA_USER_DAILY=100
AI_QUOTA_USER_MONTHLY=1000
AI_QUOTA_WORKSPACE_DAILY=1000
AI_QUOTA_WORKSPACE_MONTHLY=10000
AI_QUOTA_USER_CONCURRENT=2
AI_QUOTA_WORKSPACE_CONCURRENT=5

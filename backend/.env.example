# Database
DATABASE_URL="postgresql://postgres:password@localhost:5433/devsync?schema=public"

# Clerk authentication (configure Google, GitHub and SAML connections in Clerk)
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# 64 hexadecimal characters (generate once with: openssl rand -hex 32)
ENCRYPTION_KEY=""

# Server & CORS
PORT=5000
FRONTEND_URL="http://localhost:3000"

# AI Provider (Optional)
GROQ_API_KEY=""

# Embeddings for workspace RAG (OpenAI-compatible embedding provider)
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"

# GitHub webhook secrets are stored per connected repository. This is only
# needed if a future GitHub App installation flow uses a shared app secret.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
